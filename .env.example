# === SECRET KEY ===
SECRET_KEY="super-secret-enterprise-key-change-me-in-production"

# === GOOGLE AUTH ===
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# === ENVIRONMENT CONFIG ===
# When APP_ENV="production" (like on Render), the backend uses the live Supabase URLs below.
# Locally (when APP_ENV is omitted), it uses local SQLite databases to prevent accidentally crashing production data!
# APP_ENV="development"

# === PRODUCTION DATABASE SHARDS ===
# You can point all these to the same Supabase URL for global sync
NORTH_DB_URL="postgresql://user:pass@host:5432/db"
SOUTH_DB_URL="postgresql://user:pass@host:5432/db"
EAST_DB_URL="postgresql://user:pass@host:5432/db"
WEST_DB_URL="postgresql://user:pass@host:5432/db"

# === MOBILE APP (Injected by orchestration/k8s_app.py) ===
# EXPO_PUBLIC_BACKEND_URL="http://192.168.0.2:8000"
