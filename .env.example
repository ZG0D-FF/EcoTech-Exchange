# ==========================================
# EcoTech Exchange - Environment Variables
# ==========================================
# 🛑 DO NOT COMMIT YOUR REAL .env FILE TO GITHUB!
# Copy this file to a new file named `.env` and fill in your values.

# --- Production Deployment (Vercel / Railway) ---

# Database URL:
# Locally: Leave blank to use local SQLite databases (North/South shards).
# Production: Railway will auto-inject this when you attach a PostgreSQL database.
DATABASE_URL=

# Redis Cache:
# Locally: Leave blank to use the zero-RAM In-Memory cache.
# Production: Set this to your Upstash Redis URL.
REDIS_URL=

# Port for the FastAPI server
# Railway will automatically inject this dynamically. Locally it defaults to 8001.
PORT=8001

# Allowed CORS Origins
# Locally: Use your Vite dev server URLs.
# Production: Change this to your live Vercel frontend URL (e.g., https://ecotech.vercel.app)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
